# Save as runtime/simulator/simulator.env. Never commit real credentials.
SIM_PROJECT_NAME=huiyan-simulator
SIM_API_URL=http://host.docker.internal:4192
SIM_DEVICE_TOKEN=replace-with-a-SIMULATED-device-credential
SIM_WEB_PASSWORD=replace-with-a-random-16-plus-character-password
SIM_WEB_PORT=4196
SIM_BIND_ADDRESS=127.0.0.1
SIM_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional public main-platform URL; empty uses current browser hostname with port 4181.
SIM_PLATFORM_URL=
