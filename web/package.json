{
  "name": "huiyan-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4180 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4180 --strictPort",
    "test": "npm run test:domain && npm run test:components && npm run test:ui",
    "test:domain": "tsx --test src/domain/store.test.ts src/domain/detectionWindow.test.ts src/domain/csv.test.ts src/domain/historyQuery.test.ts src/auth/permissions.test.ts",
    "test:components": "tsx --tsconfig tsconfig.app.json --test src/ui/components.test.ts",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "echarts": "6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.2",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
