# Normal Ubuntu: loopback only. Do not expose operator UI to untrusted networks.
EDGE_LISTEN=127.0.0.1:4198
EDGE_INFLUX_URL=http://127.0.0.1:8086
EDGE_INFLUX_ORG=huiyan-edge
EDGE_INFLUX_BUCKET=measurements
# Initial bucket retention: 0 = keep history; existing bucket is never reset.
EDGE_INFLUX_RETENTION_SECONDS=0
# Local installation generates credentials in DATA/influx-credentials.json (0600).
# External InfluxDB requires HTTPS, a pre-created bucket and EDGE_INFLUX_TOKEN.
# Enable only when the central edge.v1 adapter is implemented and verified.
# EDGE_CENTER_URL=https://your-center.example
# EDGE_CENTER_TOKEN=REPLACE_WITH_MACHINE_CREDENTIAL
# EDGE_INBOUND_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# EDGE02: current center API; do not enable EDGE_CENTER_URL at the same time.
# EDGE_PLATFORM_URL=https://your-center.example
# EDGE_PLATFORM_DEVICE_TOKEN=EXISTING_SCOPED_DEVICE_CREDENTIAL
# OVALITY_EDGE_TOKEN=SEPARATE_SECRET_SHARED_WITH_CENTER
# EDGE_GATEWAY_ID=huiyan-edge-01
# EDGE05: comma-separated platform device IDs accepted by this installation.
# EDGE_SYNC_DEVICE_IDS=HY-BY-01
